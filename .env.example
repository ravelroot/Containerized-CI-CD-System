# Vau · configuração. Copie para .env e ajuste. Variáveis do ambiente
# (Docker, systemd, CI) têm prioridade sobre este arquivo.

# Endereço público do painel (usado nos links dos webhooks, status e avisos)
VAU_APP_URL=http://127.0.0.1:8080
VAU_TIMEZONE=America/Sao_Paulo

# Banco: SQLite (padrão), MySQL/MariaDB ou PostgreSQL
VAU_DATABASE_URL=sqlite:storage/vau.sqlite
# VAU_DATABASE_URL=mysql://vau:senha@127.0.0.1:3306/vau
# VAU_DATABASE_URL=pgsql://vau:senha@127.0.0.1:5432/vau

# Chave que cifra segredos no banco. Vazia = gerada em storage/.chave.
# Em produção com vários servidores, gere com: php bin/vau key:generate
VAU_APP_KEY=

# Execução dos builds: docker (isolado, padrão) ou local (sem isolamento, só para desenvolvimento)
VAU_RUNTIME=docker
VAU_DOCKER_BIN=docker
VAU_CLONE_IMAGE=alpine/git:latest
VAU_DEFAULT_IMAGE=alpine:3.20

# Limites padrão de cada container (o projeto pode mudar CPU, memória, rede e tempo)
VAU_BUILD_TIMEOUT=30
VAU_CPUS=1.0
VAU_MEMORY=1g
VAU_PIDS_LIMIT=512
VAU_NETWORK=bridge
VAU_DROP_CAPABILITIES=true
VAU_CLONE_DEPTH=50

# Logs e retenção
VAU_MAX_LOG_MB=10
VAU_LOG_RETENTION_DAYS=30
VAU_LOG_LEVEL=info

# Proteções
VAU_MAX_PAYLOAD_KB=2048
VAU_WEBHOOK_RATE_LIMIT=120
VAU_LOGIN_MAX_ATTEMPTS=5
VAU_LOGIN_LOCK_MINUTES=15
VAU_SESSION_MINUTES=480
# Token para proteger /metrics (vazio = aberto)
VAU_METRICS_TOKEN=

# Worker
VAU_WORKER_SLEEP=2
VAU_WORKER_STALE_SECONDS=120
